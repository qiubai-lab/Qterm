{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Qterm",
  "identifier": "com.qiubai.qterm",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "Qterm",
        "width": 1040,
        "height": 720,
        "minWidth": 720,
        "minHeight": 520,
        "resizable": true,
        "decorations": false,
        "theme": "Dark",
        "transparent": true,
        "shadow": true,
        "windowEffects": {
          "effects": ["hudWindow", "mica", "acrylic", "blur"]
        }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
