# Copy to .env beside compose.yaml. Never put passwords in this file.
# main/latest are published after main passes quality and container acceptance checks.
QTERM_IMAGE=ghcr.io/qiubai-lab/qterm:latest
# Host networking: the service binds directly to this host address and port.
QTERM_BIND_HOST=0.0.0.0
QTERM_PORT=8080
# Set this to the exact browser URL, e.g. http://192.168.1.10:8080.
QTERM_PUBLIC_ORIGIN=http://localhost:8080
QTERM_ALLOW_INSECURE_HTTP=true
QTERM_PASSWORD_SOURCE_FILE=./.server-secrets/password
# For HTTPS via a local proxy: bind 127.0.0.1, set the HTTPS origin, and set HTTP allowance to false.
# Optional container resource limits; unset means unlimited.
# QTERM_MEMORY_LIMIT=4g
# QTERM_CPU_LIMIT=2
# QTERM_PIDS_LIMIT=1024
