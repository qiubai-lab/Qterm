+/// CEF 154's Alloy native popup closes its NSWindow but can leave the browser
+/// view retained by AppKit. Detach the exact view after the normal close
+/// handshake, so CefBrowserHostView::dealloc acknowledges browser destruction.
+/// Only applies to popups we created with an unset parent_view, never a shared
+/// Tauri host window or Chrome-style tabs. Must run after DoClose on the UI loop.
+pub(crate) fn destroy_popup_host_window(browser: &cef::Browser) {
+  use cef::ImplBrowser;
+  if browser.is_valid() == 0 || browser.is_popup() == 0 { return; }
+  let Some(host) = browser.host() else { return; };
+  if host.runtime_style() != cef::RuntimeStyle::ALLOY { return; }
+  let Some(view) = (unsafe { Retained::<NSView>::retain(host.window_handle().cast()) }) else { return; };
+  if let Some(window) = view.window() {
+    // DoClose returned false before this event is processed. CEF's delegate
+    // now accepts performClose and schedules release of its window reference.
+    window.performClose(None);
+  }
+  view.removeFromSuperview();
+}
