+bool VtIo::BeginOrderedResize()
+{
+    if (!_orderedProbe) return false;
+    // Seal old-size output before changing console state. Writer's async front
+    // buffer is serialized by _flushNow before the next record is submitted.
+    _flushNow();
+    ++_corked;
+    return true;
+}
+
+void VtIo::EndOrderedResize(til::size size, bool success)
+{
+    if (!success)
+    {
+        // A partial native failure cannot be represented as successful resize.
+        _hOutput.reset();
+        _back.clear();
+        --_corked;
+        return;
+    }
+    _orderedSize = size;
+    _orderedResize = true;
+    _uncork();
+}
 
